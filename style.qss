/* ============================================
   车辆管理系统 (VMS) - 全局样式表
   现代扁平化设计 | 蓝色主色调
   ============================================ */

/* ---------- 全局 ---------- */
QMainWindow {
    background-color: #f0f2f5;
}

/* ---------- 菜单栏 ---------- */
QMenuBar {
    background-color: #1a1a2e;
    color: #e0e0e0;
    padding: 2px 0;
    font-size: 13px;
    border-bottom: 1px solid #16213e;
}
QMenuBar::item {
    padding: 6px 12px;
    border-radius: 4px;
    margin: 1px 2px;
}
QMenuBar::item:selected {
    background-color: #0f3460;
    color: #ffffff;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d5d9e0;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    padding: 8px 36px 8px 20px;
    border-radius: 5px;
    font-size: 13px;
}
QMenu::item:selected {
    background-color: #e8f0fe;
    color: #1a73e8;
}
QMenu::separator {
    height: 1px;
    background: #e8eaed;
    margin: 5px 12px;
}

/* ---------- 工具栏 ---------- */
QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e3e8;
    padding: 5px 8px;
    spacing: 6px;
}
QToolBar::separator {
    width: 1px;
    background: #e0e3e8;
    margin: 4px 6px;
}
QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 7px 16px;
    font-size: 13px;
    color: #444;
}
QToolBar QToolButton:hover {
    background-color: #e8f0fe;
    color: #1a73e8;
}
QToolBar QToolButton:pressed {
    background-color: #1a73e8;
    color: #ffffff;
}

/* ---------- 分组框 ---------- */
QGroupBox {
    font-size: 13px;
    font-weight: bold;
    color: #333;
    background-color: #ffffff;
    border: 1px solid #e0e3e8;
    border-radius: 10px;
    margin-top: 14px;
    padding: 20px 16px 12px 16px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 10px;
    color: #1a73e8;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background-color: #1a73e8;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #1557b0;
}
QPushButton:pressed {
    background-color: #0d47a1;
}
QPushButton:default {
    background-color: #0f9d58;
}
QPushButton:default:hover {
    background-color: #0b8043;
}
QPushButton:disabled {
    background-color: #c4c7cc;
    color: #888;
}

/* ---------- 输入框 ---------- */
QLineEdit {
    border: 2px solid #dadce0;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    background-color: #ffffff;
    color: #333;
}
QLineEdit:focus {
    border-color: #1a73e8;
    background-color: #f8faff;
}
QLineEdit[readOnly="true"] {
    background-color: #f1f3f4;
    color: #888;
}

/* ---------- 单选按钮 ---------- */
QRadioButton {
    font-size: 13px;
    color: #444;
    spacing: 6px;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #bdc1c6;
    border-radius: 10px;
    background-color: #ffffff;
}
QRadioButton::indicator:hover {
    border-color: #1a73e8;
}
QRadioButton::indicator:checked {
    border: 2px solid #1a73e8;
    background-color: qradialgradient(
        cx:0.5, cy:0.5, radius:0.4,
        fx:0.5, fy:0.5,
        stop:0 #1a73e8, stop:0.5 #1a73e8,
        stop:0.6 #ffffff, stop:1 #ffffff
    );
}

/* ---------- 下拉框 & 数字框 & 日期框 ---------- */
QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    border: 2px solid #dadce0;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    background-color: #ffffff;
    color: #333;
}
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border-color: #1a73e8;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    border-left: 1px solid #e0e3e8;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}
QComboBox QAbstractItemView {
    border: 1px solid #dadce0;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #e8f0fe;
    selection-color: #333;
    outline: none;
}

/* ---------- 表格 ---------- */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8f9fb;
    border: 1px solid #dadce0;
    border-radius: 8px;
    gridline-color: #eee;
    font-size: 13px;
    selection-background-color: #e8f0fe;
    selection-color: #333;
    outline: none;
}
QTableWidget::item {
    padding: 7px 12px;
}
QTableWidget::item:hover {
    background-color: #f0f4ff;
}
QTableWidget::item:selected {
    background-color: #d2e3fc;
    color: #1a1a2e;
}

/* 表头 */
QHeaderView::section {
    background-color: #f1f3f4;
    color: #444;
    font-weight: bold;
    font-size: 12px;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid #1a73e8;
    border-right: 1px solid #e0e3e8;
}
QHeaderView::section:hover {
    background-color: #e8eaed;
}
QHeaderView::up-arrow, QHeaderView::down-arrow {
    width: 12px;
    height: 12px;
}
QHeaderView::down-arrow {
    image: none;
    /* 用 CSS border 模拟三角箭头在代码里处理，这里保留占位 */
}

/* ---------- 状态栏 ---------- */
QStatusBar {
    background-color: #1a1a2e;
    color: #c0c0d0;
    font-size: 12px;
    padding: 0;
    border-top: 1px solid #16213e;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: #d0d0e0;
    padding: 4px 14px;
    border-right: 1px solid #2a2a4a;
}
QStatusBar QLabel:last-child {
    border-right: none;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c4c7cc;
    border-radius: 4px;
    min-height: 36px;
}
QScrollBar::handle:vertical:hover {
    background: #9aa0a6;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #c4c7cc;
    border-radius: 4px;
    min-width: 36px;
}
QScrollBar::handle:horizontal:hover {
    background: #9aa0a6;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- 对话框按钮盒 ---------- */
QDialogButtonBox QPushButton {
    min-width: 100px;
}

/* ---------- 提示标签 ---------- */
QLabel#emptyHint {
    color: #999;
    font-size: 16px;
    padding: 40px;
}

/* ---------- 图表 ---------- */
QChartView {
    background: transparent;
    border: none;
}

/* ---------- 工具提示 ---------- */
QToolTip {
    background-color: #333;
    color: #fff;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}
